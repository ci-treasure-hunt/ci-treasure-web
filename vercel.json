{
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)supabase' ':(exclude)tests' ':(exclude)AGENTS.md' ':(exclude)CLAUDE.md' ':(exclude)CONTRIBUTING.md' ':(exclude)README.md'",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/stats/:match*",
      "destination": "https://ci-treasure-analytics.vercel.app/:match*"
    }
  ]
}
