# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Written by `next dev` on every start (node_modules/next/dist/server/lib/
# generate-agent-files.js): AGENTS.md holds Next's own agent rules and CLAUDE.md
# is an 11-byte "@AGENTS.md" import. Next suggests committing them; we don't,
# because this repo is public and they read as project documentation without
# being any. Nothing needs them at build or run time.
AGENTS.md
CLAUDE.md
